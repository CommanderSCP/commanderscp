{
  "name": "@scp/vendor-refresh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vendor-refresh": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
