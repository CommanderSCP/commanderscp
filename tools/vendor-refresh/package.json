  },
  "dependencies": {
    "@scp/cosign": "workspace:*",
    "@scp/dependency-manifests": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "vitest": "^3.0.0"
  }
}
